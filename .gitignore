# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local build, preview and QA artifacts (not public website assets)
/.next-*/
/*-build-20*/
/*-cache-20*/
/tmp/
/output/
/artifacts/
/screenshots/
/playwright-report/
/test-results/
/coverage/
*.log
*.tmp

